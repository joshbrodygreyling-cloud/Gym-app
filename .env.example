# LiftIQ environment variables
#
# Anthropic API key used by the machine-identifier serverless function
# (api/identify.ts). This is a SERVER-SIDE secret — it is NOT exposed to the
# browser. Do NOT prefix it with VITE_, or it would be bundled into the public
# client code.
#
# Local dev:   put the real value in a .env.local file (gitignored).
# Production:  set this in your Vercel project → Settings → Environment Variables.
ANTHROPIC_API_KEY=sk-ant-your-key-here
